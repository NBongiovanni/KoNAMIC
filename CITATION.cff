    affiliation: "Université Côte d'Azur, CNRS, I3S"
    orcid: "https://orcid.org/0009-0009-8150-078X"

keywords:
  - Koopman operator
  - neural networks
  - nonlinear system identification
  - machine learning
  - robotics
  - model predictive control
  - quadrotor

